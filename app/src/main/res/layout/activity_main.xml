<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="60dp" />

    <ImageView
        android:id="@+id/ivFreeze"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="60dp"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <com.portraitcam.GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="60dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">
        <com.portraitcam.IconView
            android:id="@+id/icSettings"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
        <com.portraitcam.IconView
            android:id="@+id/icFlash"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
        <com.portraitcam.IconView
            android:id="@+id/icTimer"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
        <com.portraitcam.IconView
            android:id="@+id/icRatio"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
        <com.portraitcam.IconView
            android:id="@+id/icGrid"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
        <com.portraitcam.IconView
            android:id="@+id/icFilter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvJobs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="68dp"
        android:background="@drawable/pill_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="96sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBusy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/pill_bg"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/blurRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="Blur"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
            <SeekBar
                android:id="@+id/blurSeek"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="40" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pill_bg"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView android:id="@+id/z05" style="@style/Chip" android:text=".5" />
            <TextView android:id="@+id/z1" style="@style/Chip" android:text="1x" />
            <TextView android:id="@+id/z2" style="@style/Chip" android:text="2x" />
            <TextView android:id="@+id/z3" style="@style/Chip" android:text="3x" />
            <TextView android:id="@+id/z5" style="@style/Chip" android:text="5x" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/tvNight" style="@style/Mode" android:text="NIGHT" />
            <TextView android:id="@+id/tvPhoto" style="@style/Mode" android:text="PHOTO" />
            <TextView android:id="@+id/tvPortrait" style="@style/Mode" android:text="PORTRAIT" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="44dp"
            android:paddingRight="44dp">
            <ImageView
                android:id="@+id/gallery"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/thumb_circle"
                android:scaleType="centerCrop" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View
                android:id="@+id/shutter"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:background="@drawable/shutter" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <com.portraitcam.IconView
                android:id="@+id/icFlip"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/chip_bg" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="true"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/sheet_bg"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Camera settings"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="Brightness"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/brightSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="Detail"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/detailSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="40" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:text="Face smooth"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
                <SeekBar
                    android:id="@+id/beautySeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvHdr" style="@style/SheetChip" />
                <TextView android:id="@+id/tvNr" style="@style/SheetChip" />
                <TextView android:id="@+id/tvAi" style="@style/SheetChip" />
                <TextView android:id="@+id/tvTele" style="@style/SheetChip" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvInfo" style="@style/SheetChip" />
                <TextView android:id="@+id/tvEnh" style="@style/SheetChip" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
